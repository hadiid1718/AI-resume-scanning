# Application
APP_NAME=AI Resume Scanning System
ENVIRONMENT=development

# Database
# Default is a local SQLite file so the backend runs with zero setup.
# To use the bundled PostgreSQL (docker compose up -d postgres), switch to:
# DATABASE_URL=postgresql+psycopg://resume_user:resume_password@localhost:5432/resume_scanner
DATABASE_URL=sqlite:///./resume_scanner.db

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:8501

# Frontend -> backend
STREAMLIT_BACKEND_URL=http://localhost:8000

# Gemini (only needed for /api/v1/ai/* endpoints)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash


# Storage
UPLOAD_DIR=uploads
REPORT_DIR=reports
